{
  "manifest_version": 3,
  "name": "云盘助手",
  "version": "0.5.0",
  "description": "连接 115、光鸭和 123，选择目标目录，通过右键转存分享链接并核实结果。",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "contextMenus"
  ],
  "host_permissions": [
    "https://dapi.guangyapan.com/*",
    "https://www.guangyapan.com/*",
    "https://api.guangyapan.com/*",
    "https://qrcodeapi.115.com/*",
    "https://passportapi.115.com/*",
    "https://webapi.115.com/*",
    "https://proapi.115.com/*",
    "https://api.123278.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开云盘助手配置"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
