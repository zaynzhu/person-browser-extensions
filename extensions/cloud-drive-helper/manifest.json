{
  "manifest_version": 3,
  "name": "云盘助手",
  "version": "0.3.0",
  "description": "115 支持选择客户端扫码并保存会话，光鸭保留双方式连接；浏览文件夹与保存目标目录，123 待接入。",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://dapi.guangyapan.com/*",
    "https://www.guangyapan.com/*",
    "https://api.guangyapan.com/*",
    "https://qrcodeapi.115.com/*",
    "https://passportapi.115.com/*",
    "https://webapi.115.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开云盘助手配置"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
