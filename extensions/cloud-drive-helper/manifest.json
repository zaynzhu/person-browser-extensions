{
  "manifest_version": 3,
  "name": "云盘助手",
  "version": "0.4.1",
  "description": "115 手机扫码、光鸭双方式连接、123 账号密码登录；读取文件夹并保存目标目录。",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://dapi.guangyapan.com/*",
    "https://www.guangyapan.com/*",
    "https://api.guangyapan.com/*",
    "https://qrcodeapi.115.com/*",
    "https://passportapi.115.com/*",
    "https://webapi.115.com/*",
    "https://proapi.115.com/*",
    "https://api.123278.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开云盘助手配置"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
